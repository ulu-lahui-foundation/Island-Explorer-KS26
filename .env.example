# Copy to .env (repo root) and fill in. Loaded by the api-server at startup.

# Roboflow key for the plant-identification workflow (POST /api/classify-plant).
# Without it the app runs, but photo identification returns a 500.
ROBOFLOW_API_KEY=

# Optional: API server port (default 3001). The game's Vite proxy reads the same var.
# API_PORT=3001
